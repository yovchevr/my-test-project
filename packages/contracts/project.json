{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/contracts/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/contracts",
        "command": "tsc --noEmit -p tsconfig.json"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/contracts",
        "command": "tsc --noEmit -p tsconfig.json"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/contracts",
        "command": "eslint ."
      },
      "cache": true
    }
  }
}

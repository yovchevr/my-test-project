{
  "name": "tools-web-search",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tools-web-search/src",
  "projectType": "library",
  "tags": ["layer:tools"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/tools-web-search",
        "command": "tsc --noEmit -p tsconfig.json"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/tools-web-search",
        "command": "tsc --noEmit -p tsconfig.json"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/tools-web-search",
        "command": "eslint ."
      },
      "cache": true
    }
  }
}

{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/api/src",
  "projectType": "library",
  "tags": ["layer:api"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "services/api",
        "command": "tsc --noEmit -p tsconfig.json"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "services/api",
        "command": "tsc --noEmit -p tsconfig.json"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "services/api",
        "command": "eslint ."
      },
      "cache": true
    }
  }
}

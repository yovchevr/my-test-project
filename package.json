    "eslint": "9.14.0",
    "globals": "15.12.0",
    "nx": "20.1.4",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vitest": "2.1.4"
  }

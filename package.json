{
  "name": "@neo-search/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "22.11.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "concurrently --kill-others --names 'api,ui' 'pnpm --filter @neo-search/api start' 'pnpm --filter @neo-search/ui dev'",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "type-check": "nx run-many -t type-check",
    "madge": "madge --circular --extensions ts,tsx apps services packages",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test --project=chromium --project=firefox",
    "e2e:smoke": "playwright test --project=smoke",
    "pre-commit": "lefthook run pre-commit",
    "gates": "pnpm format && pnpm lint && pnpm type-check && pnpm madge && pnpm test && pnpm coverage",
    "clean": "nx reset && rm -rf node_modules **/node_modules **/dist **/build **/coverage"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "20.1.4",
    "@playwright/test": "1.48.2",
    "@types/node": "22.9.0",
    "@typescript-eslint/eslint-plugin": "8.13.0",
    "@typescript-eslint/parser": "8.13.0",
    "@vitest/coverage-v8": "2.1.4",
    "concurrently": "9.1.0",
    "eslint": "9.14.0",
    "globals": "15.12.0",
    "jsonc-eslint-parser": "2.4.0",
    "lefthook": "1.8.2",
    "madge": "8.0.0",
    "nx": "20.1.4",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vitest": "2.1.4"
  }
}

{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ui/src",
  "projectType": "application",
  "tags": ["layer:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ui",
        "command": "vite build"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ui",
        "command": "vite"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ui",
        "command": "tsc --noEmit -p tsconfig.json"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ui",
        "command": "eslint ."
      },
      "cache": true
    }
  }
}
